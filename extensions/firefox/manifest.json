{
  "manifest_version": 3,
  "name": "OmniConv",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "contextMenus",
    "notifications",
    "activeTab",
    "downloads",
    "downloads.open",
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniConv",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "__MSG_cmdOpen__"
    },
    "quick-download": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "__MSG_cmdQuickDownload__"
    },
    "quick-audio": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "__MSG_cmdQuickAudio__"
    }
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "omniconv@gad.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
